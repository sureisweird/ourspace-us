# PIN Pengaman (4 digit) - Contoh: Tanggal lahir, tanggal jadian, tanggal wisuda, dll.
PIN_CODE=0614

# Aset Media / URL Gambar (Bisa menggunakan Cloudinary, Unsplash, atau path lokal /images/...)
# Sesuaikan gambar dengan momen Anda (Anniversary, Ulang Tahun, Pernikahan, Wisuda, dll.)
CLOUDINARY_IMAGE_HERO=
CLOUDINARY_IMAGE_ALBUM=
CLOUDINARY_IMAGE_1=
CLOUDINARY_IMAGE_2=
CLOUDINARY_IMAGE_3=
CLOUDINARY_IMAGE_4=
